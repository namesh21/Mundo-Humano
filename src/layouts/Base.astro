---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE } from '../config';

interface Props {
  /** Título exato da aba/SERP. Se omitido, usa `title | marca`. */
  seoTitle?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Blocos JSON-LD extras da página (FAQPage, BreadcrumbList, Service...) */
  schema?: Record<string, unknown>[];
}

const { seoTitle, title, noindex = false, description = SITE.descricao, type = 'website', schema = [] } = Astro.props;
const fullTitle = seoTitle ?? (title ? `${title} | ${SITE.marca}` : `Psicólogo em Campo Grande (MS) | ${SITE.profissional}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const negocio = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'MedicalBusiness'],
  '@id': new URL('/#consultorio', Astro.site).href,
  name: `${SITE.marca} · ${SITE.profissional}, psicólogo`,
  description: SITE.descricao,
  url: Astro.site?.href,
  logo: new URL('/favicon.svg', Astro.site).href,
  image: ogImage.href,
  email: SITE.email,
  telephone: `+${SITE.whatsapp}`,
  priceRange: '$$',
  paymentAccepted: SITE.pagamento,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${SITE.endereco}, ${SITE.bairro}`,
    addressLocality: SITE.cidade,
    addressRegion: SITE.uf,
    addressCountry: 'BR',
  },
  hasMap: SITE.mapa,
  areaServed: [
    { '@type': 'City', name: 'Campo Grande, MS' },
    { '@type': 'Country', name: 'Brasil' },
  ],
  knowsAbout: [
    'Psicoterapia',
    'Terapia de casal',
    'Terapia familiar',
    'Terapia cognitivo-comportamental',
    'Terapia narrativa',
    'Atendimento psicológico LGBTQIA+',
    'Orientação vocacional',
    'Avaliação psicológica',
  ],
  potentialAction: {
    '@type': 'ReserveAction',
    name: 'Agendar consulta',
    target: { '@type': 'EntryPoint', urlTemplate: SITE.agenda },
  },
  sameAs: [SITE.linkedin],
  founder: {
    '@type': 'Person',
    '@id': new URL('/#marcel', Astro.site).href,
    name: SITE.profissional,
    jobTitle: 'Psicólogo Clínico',
    identifier: SITE.crp,
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidade Católica Dom Bosco' },
    sameAs: [SITE.linkedin],
  },
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f2ea" />
    <meta name="geo.region" content="BR-MS" />
    <meta name="geo.placename" content="Campo Grande" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.marca} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...s })} />)}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
