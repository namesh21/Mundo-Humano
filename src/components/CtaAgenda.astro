---
import { SITE, whatsappLink } from '../config';
interface Props {
  titulo?: string;
  texto?: string;
  msgWhatsapp?: string;
}
const {
  titulo = 'Se fizer sentido para você, podemos começar por uma conversa.',
  texto = 'Os horários livres e os valores estão na agenda online. Presencial em Campo Grande ou online.',
  msgWhatsapp,
} = Astro.props;
---
<aside class="cta-agenda">
  <div class="wrap cta-agenda__grid">
    <h2>{titulo}</h2>
    <div>
      <p>{texto}</p>
      <div class="cta-agenda__acoes">
        <a class="btn btn--claro" href={SITE.agenda} target="_blank" rel="noopener">Agendar consulta</a>
        <a class="link-sec" href={whatsappLink(msgWhatsapp)} target="_blank" rel="noopener">Prefiro conversar no WhatsApp</a>
      </div>
      <p class="cta-agenda__url">
        Agenda online: <a href={SITE.agenda} target="_blank" rel="noopener">{SITE.agenda.replace('https://', '')}</a>
      </p>
    </div>
  </div>
</aside>

<style>
  .cta-agenda { background: var(--azul); color: #fff; padding: clamp(5rem, 10vw, 7.5rem) 0; }
  .cta-agenda__grid { display: grid; gap: 2.5rem; align-items: end; }
  .cta-agenda h2 { font-size: clamp(2.1rem, 4.4vw, 3.5rem); max-width: 18ch; margin: 0; color: #fff; }
  .cta-agenda p { color: #dbe6f0; }
  .cta-agenda .link-sec { color: #fff; text-decoration-color: rgb(255 255 255 / 0.5); }
  .cta-agenda__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin: 1.8rem 0; }
  .cta-agenda__url { font-size: 0.9rem; word-break: break-all; color: #b9cde0 !important; }
  .cta-agenda__url a { color: #fff; }
  @media (min-width: 900px) { .cta-agenda__grid { grid-template-columns: 1.4fr 1fr; gap: 6rem; } }
</style>
