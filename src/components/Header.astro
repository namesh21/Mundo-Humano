---
import { SITE, whatsappLink } from '../config';

const links = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#atendimento', label: 'Atendimento' },
  { href: '/#como-funciona', label: 'Como funciona' },
  { href: '/blog/', label: 'Blog' },
  { href: '/#contato', label: 'Contato' },
];
---
<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="logo" aria-label={`${SITE.marca} — página inicial`}>
      <svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="22" fill="none" stroke="currentColor" stroke-width="4" />
        <circle cx="32" cy="32" r="7" fill="#b4573a" />
      </svg>
      <span>{SITE.marca}</span>
    </a>

    <nav aria-label="Principal">
      <ul class="nav-desktop">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener">Agendar conversa</a></li>
      </ul>
      <details class="menu">
        <summary aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </summary>
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li class="menu__cta">
            <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener">Agendar conversa</a>
          </li>
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Fecha o menu mobile ao clicar em um link
  document.querySelectorAll<HTMLAnchorElement>('.menu a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(247 242 234 / 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .logo {
    display: flex; align-items: center; gap: 0.6rem;
    color: var(--green); text-decoration: none;
    font-family: var(--serif); font-size: 1.35rem; font-weight: 500;
  }
  .logo span { color: var(--ink); }

  .menu summary {
    list-style: none; cursor: pointer; width: 44px; height: 44px;
    display: grid; place-content: center; gap: 5px;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; }
  .menu ul {
    list-style: none; margin: 0; padding: 1rem 1.25rem 1.5rem;
    position: absolute; left: 0; right: 0; top: 72px;
    background: var(--bg); border-bottom: 1px solid var(--line);
    display: grid; gap: 0.25rem;
  }
  .menu li a:not(.btn) { display: block; padding: 0.7rem 0; color: var(--ink); text-decoration: none; font-weight: 500; }
  .menu__cta { margin-top: 0.5rem; }

  .nav-desktop { display: none; }
  @media (min-width: 900px) {
    .menu { display: none; }
    .nav-desktop { display: flex; align-items: center; gap: 1.8rem; list-style: none; margin: 0; padding: 0; }
    .nav-desktop a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.95rem; }
    .nav-desktop a:not(.btn):hover { color: var(--accent); }
    .nav-desktop .btn { padding: 0.65rem 1.2rem; }
  }
</style>

