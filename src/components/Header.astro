---
import { SITE } from '../config';
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';

const temPosts = (await getCollection('blog', ({ data }) => !data.rascunho)).length > 0;
const links = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#atendimento', label: 'Atendimentos' },
  { href: '/terapia-de-casal-campo-grande/', label: 'Terapia de casal' },
  { href: '/psicologo-lgbt-campo-grande/', label: 'Terapia inclusiva' },
  ...(temPosts ? [{ href: '/blog/', label: 'Blog' }] : []),
  { href: '/#contato', label: 'Contato' },
];
---
<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="logo" aria-label={`${SITE.marca}, página inicial`}>
      <Logo size={42} />
      <span class="logo__text">Mundo<br />Humano</span>
    </a>

    <nav aria-label="Principal">
      <ul class="nav-desktop">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a class="btn btn--primary" href={SITE.agenda} target="_blank" rel="noopener">Agendar consulta</a></li>
      </ul>
      <details class="menu">
        <summary aria-label="Abrir menu">Menu</summary>
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li class="menu__cta">
            <a class="btn btn--primary" href={SITE.agenda} target="_blank" rel="noopener">Agendar consulta</a>
          </li>
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.menu a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: var(--cobalto); color: #fff; }
  .header__inner { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  .logo { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: #fff; }
  .logo__text { font-family: var(--display); font-weight: 700; font-size: 1.02rem; line-height: 0.98; letter-spacing: -0.01em; }
  .logo:hover { color: var(--caninde); }

  .menu summary {
    list-style: none; cursor: pointer; min-height: 44px; padding: 0.5rem 1.1rem;
    border: 2px solid #fff; border-radius: 999px; font-family: var(--display); font-weight: 700;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { background: #fff; color: var(--cobalto); }
  .menu ul {
    list-style: none; margin: 0; padding: 1rem var(--gutter) 1.8rem;
    position: absolute; left: 0; right: 0; top: 76px;
    background: var(--cobalto); display: grid; gap: 0;
  }
  .menu li a:not(.btn) {
    display: block; padding: 0.8rem 0; color: #fff; text-decoration: none;
    font-family: var(--display); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em;
    border-bottom: 1px solid rgb(255 255 255 / 0.15);
  }
  .menu__cta { margin-top: 1.2rem; }

  .nav-desktop { display: none; }
  @media (min-width: 1040px) {
    .menu { display: none; }
    .nav-desktop { display: flex; align-items: center; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
    .nav-desktop a:not(.btn) { color: #fff; text-decoration: none; font-weight: 600; font-size: 0.98rem; }
    .nav-desktop a:not(.btn):hover { color: var(--caninde); }
    .nav-desktop .btn { min-height: 44px; padding: 0.55rem 1.2rem; }
  }
</style>
