---
import { SITE, telefoneFormatado, whatsappLink } from '../config';
const ano = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <p class="footer__brand"><img src="/favicon.svg" width="40" height="40" alt="" />{SITE.marca}</p>
      <p>{SITE.profissional} · Psicólogo clínico · {SITE.crp}</p>
      <p class="muted">
        <a href={SITE.mapa} target="_blank" rel="noopener">{SITE.endereco}<br />{SITE.bairro} · {SITE.cidade}/{SITE.uf}</a>
      </p>
    </div>
    <div>
      <p class="footer__title">Contato</p>
      <p>
        <a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp {telefoneFormatado()}</a><br />
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
        <a href={SITE.agenda} target="_blank" rel="noopener">Agenda online</a><br />
        <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </div>
    <div class="footer__notice">
      <p class="footer__title">Em situação de crise</p>
      <p>
        Este site não oferece atendimento de urgência. Se você estiver em sofrimento intenso,
        ligue para o <strong>CVV — 188</strong> (24h, gratuito) ou procure o <strong>SAMU — 192</strong>.
      </p>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <p>© {ano} {SITE.marca} · {SITE.profissional}. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .footer { background: var(--ink); color: #d9d0c3; padding: 4rem 0 1.5rem; font-size: 0.95rem; }
  .footer a { color: #f3d3c6; }
  .muted a { color: #a99f92; }
  .footer__grid { display: grid; gap: 2.5rem; }
  .footer__brand { display: flex; align-items: center; gap: 0.7rem; font-family: var(--serif); font-size: 1.6rem; color: #fff; margin-bottom: 0.8rem; }
  .footer__title { color: #fff; font-weight: 600; margin-bottom: 0.6rem; }
  .muted { color: #a99f92; }
  .footer__notice { border-left: 2px solid var(--accent); padding-left: 1rem; }
  .footer__bottom { border-top: 1px solid #443d36; margin-top: 3rem; padding-top: 1.5rem; color: #a99f92; font-size: 0.85rem; }
  .footer__bottom p { margin: 0; }
  @media (min-width: 800px) { .footer__grid { grid-template-columns: 1.2fr 1fr 1.3fr; } }
</style>
