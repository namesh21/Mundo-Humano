---
import { SITE, telefoneFormatado, whatsappLink } from '../config';
import Logo from './Logo.astro';
const ano = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__marca">
      <Logo size={56} />
      <p class="footer__nome">Mundo Humano</p>
      <p>{SITE.profissional}, psicólogo clínico<br />{SITE.crp}</p>
      <p><a href={SITE.mapa} target="_blank" rel="noopener">{SITE.endereco}<br />{SITE.bairro}, {SITE.cidade}/{SITE.uf}</a></p>
    </div>
    <div>
      <p class="footer__titulo">Atendimentos</p>
      <ul>
        <li><a href="/terapia-de-casal-campo-grande/">Terapia de casal em Campo Grande</a></li>
        <li><a href="/psicologo-lgbt-campo-grande/">Psicólogo LGBTQIA+ e terapia inclusiva</a></li>
        <li><a href="/#atendimento">Psicoterapia individual e familiar</a></li>
        <li><a href="/#atendimento">Atendimento online</a></li>
      </ul>
    </div>
    <div>
      <p class="footer__titulo">Contato</p>
      <ul>
        <li><a href={SITE.agenda} target="_blank" rel="noopener">Agenda online</a></li>
        <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp {telefoneFormatado()}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
    </div>
    <div class="footer__crise">
      <p class="footer__titulo">Em crise agora?</p>
      <p>
        Este site não faz atendimento de urgência. Se você está em sofrimento intenso, ligue para o
        <strong>CVV, 188</strong> (24h, gratuito) ou para o <strong>SAMU, 192</strong>.
      </p>
    </div>
  </div>
  <div class="wrap footer__fim">
    <p>© {ano} Mundo Humano, {SITE.profissional}</p>
  </div>
</footer>

<style>
  .footer { background: var(--tinta); color: #c9c6e0; padding: clamp(4rem, 8vw, 5.5rem) 0 1.5rem; font-size: 0.97rem; }
  .footer a { color: #fff; text-decoration-color: rgb(255 255 255 / 0.35); }
  .footer a:hover { color: var(--ipe); }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .footer__grid { display: grid; gap: 2.5rem; }
  .footer__nome { font-family: var(--display); font-weight: 800; font-size: 1.7rem; letter-spacing: -0.03em; color: #fff; margin: 1rem 0 0.6rem; }
  .footer__titulo { font-family: var(--display); font-weight: 700; color: var(--caninde); margin-bottom: 0.8rem; }
  .footer__crise { border-left: 3px solid var(--ipe); padding-left: 1.1rem; align-self: start; }
  .footer__fim { margin-top: 3.5rem; padding-top: 1.4rem; border-top: 1px solid rgb(255 255 255 / 0.12); color: #8a87ab; font-size: 0.88rem; }
  .footer__fim p { margin: 0; }
  @media (min-width: 900px) { .footer__grid { grid-template-columns: 1.1fr 1fr 1fr 1.1fr; gap: 3rem; } }
</style>
