---
import { SITE, telefoneFormatado, whatsappLink } from '../config';
import Logo from './Logo.astro';
const ano = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__marca">
      <Logo size={48} />
      <p class="footer__nome">Mundo Humano</p>
      <p>{SITE.profissional}<br />Psicólogo clínico, {SITE.crp}</p>
      <p><a href={SITE.mapa} target="_blank" rel="noopener">{SITE.endereco}<br />{SITE.bairro}, {SITE.cidade}/{SITE.uf}</a></p>
    </div>
    <div>
      <p class="footer__titulo">Atendimentos</p>
      <ul>
        <li><a href="/terapia-de-casal-campo-grande/">Terapia de casal em Campo Grande</a></li>
        <li><a href="/psicologo-lgbt-campo-grande/">Psicólogo LGBTQIA+ e terapia inclusiva</a></li>
        <li><a href="/#atendimento">Psicoterapia individual e familiar</a></li>
        <li><a href="/#atendimento">Atendimento online</a></li>
      </ul>
    </div>
    <div>
      <p class="footer__titulo">Contato</p>
      <ul>
        <li><a href={SITE.agenda} target="_blank" rel="noopener">Agenda online</a></li>
        <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp {telefoneFormatado()}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
    </div>
    <div class="footer__crise">
      <p class="footer__titulo">Em crise agora?</p>
      <p>
        Este site não faz atendimento de urgência. Se você está em sofrimento intenso, ligue para o
        CVV, <strong>188</strong> (24h, gratuito), ou para o SAMU, <strong>192</strong>.
      </p>
    </div>
  </div>
  <div class="wrap footer__fim">
    <p>© {ano} Mundo Humano, {SITE.profissional}. Psicólogo inscrito no Conselho Regional de Psicologia da 14ª Região (MS).</p>
  </div>
</footer>

<style>
  .footer { background: var(--noite); color: #a9b6c3; padding: clamp(4rem, 8vw, 6rem) 0 1.6rem; font-size: 0.95rem; }
  .footer a { color: var(--fundo); text-decoration-color: rgb(243 239 231 / 0.3); }
  .footer a:hover { color: #9cc0e0; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .footer__grid { display: grid; gap: 2.8rem; }
  .footer__nome { font-family: var(--serif); font-size: 1.8rem; color: var(--fundo); margin: 1rem 0 0.6rem; }
  .footer__titulo { color: #9cc0e0; font-weight: 600; font-size: 0.86rem; letter-spacing: 0.04em; margin-bottom: 1rem; }
  .footer__crise { border-left: 2px solid var(--azul-logo); padding-left: 1.2rem; align-self: start; }
  .footer__fim { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--linha-escura); font-size: 0.85rem; color: #7f8d9a; }
  .footer__fim p { margin: 0; }
  @media (min-width: 900px) { .footer__grid { grid-template-columns: 1.1fr 1fr 1fr 1.1fr; gap: 3.5rem; } }
</style>
