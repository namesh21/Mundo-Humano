---
// Lista de perguntas frequentes. A página gera o schema FAQPage com `faqSchema()`.
interface Props {
  itens: { p: string; r: string }[];
}
const { itens } = Astro.props;
---
<div class="faq__list">
  {itens.map((f) => (
    <details>
      <summary>{f.p}</summary>
      <p>{f.r}</p>
    </details>
  ))}
</div>

<style>
  .faq__list { border-top: 1px solid currentColor; }
  .faq__list details { border-bottom: 1px solid var(--linha); }
  .faq__list summary {
    cursor: pointer; list-style: none; padding: 1.4rem 3rem 1.4rem 0; position: relative;
    font-family: var(--serif); font-variation-settings: 'SOFT' 100; font-size: 1.3rem; line-height: 1.3;
  }
  .faq__list summary::-webkit-details-marker { display: none; }
  .faq__list summary::before,
  .faq__list summary::after {
    content: ''; position: absolute; right: 0.3rem; top: 50%; width: 16px; height: 1px; background: var(--azul-logo);
    transition: transform 0.25s;
  }
  .faq__list summary::after { transform: rotate(90deg); }
  .faq__list details[open] summary::after { transform: rotate(0deg); }
  .faq__list details p { color: var(--tinta-suave); padding-bottom: 1.5rem; margin: 0; max-width: 40rem; }
</style>
