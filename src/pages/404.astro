---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada">
  <section class="section">
    <div class="wrap" style="max-width: 40rem;">
      <p class="eyebrow">Erro 404</p>
      <h1>Essa página se perdeu pelo caminho.</h1>
      <p class="lead">O endereço pode ter mudado ou não existir mais.</p>
      <a class="btn btn--primary" href="/">Voltar ao início</a>
    </div>
  </section>
</Base>
