---
import Base from '../layouts/Base.astro';
import { SITE, whatsappLink, telefoneFormatado } from '../config';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);

const atendimentos = [
  {
    titulo: 'Psicoterapia individual',
    texto: 'Para adultos que querem entender o que sentem, o que se repete e o que gostariam de mudar na própria história.',
  },
  {
    titulo: 'Adolescentes',
    texto: 'Escuta para quem está atravessando as mudanças da adolescência, com orientação aos responsáveis quando necessário.',
  },
  {
    titulo: 'Casais',
    texto: 'Um espaço para o casal falar do que trava a relação: comunicação, conflitos, crises e decisões importantes.',
  },
  {
    titulo: 'Atendimento online',
    texto: 'Sessões por vídeo com o mesmo cuidado do presencial, para quem mora em outra cidade ou tem rotina corrida.',
  },
];

const temas = [
  'Ansiedade e preocupação constante',
  'Tristeza, desânimo e perda de sentido',
  'Luto e perdas',
  'Relacionamentos e família',
  'Autoestima e insegurança',
  'Esgotamento e trabalho',
  'Mudanças e transições de vida',
  'Questões da maternidade e paternidade',
];

const passos = [
  { n: '01', titulo: 'Primeiro contato', texto: 'Você manda uma mensagem pelo WhatsApp ou e-mail. Respondo pessoalmente para tirar dúvidas e combinar um horário.' },
  { n: '02', titulo: 'Sessão inicial', texto: 'Uma conversa para entender o que te traz, explicar como trabalho e ver se faz sentido seguirmos juntos.' },
  { n: '03', titulo: 'Acompanhamento', texto: 'Sessões semanais de cerca de 50 minutos, presenciais ou online, no ritmo que o processo pede.' },
];

const faq = [
  {
    p: 'Preciso estar em crise para começar a terapia?',
    r: 'Não. Muita gente procura terapia para se conhecer melhor, atravessar uma fase de mudança ou entender padrões que se repetem. Não é preciso ter um motivo "grande o suficiente".',
  },
  {
    p: 'A terapia online funciona?',
    r: 'Sim. O atendimento online é regulamentado pelo Conselho Federal de Psicologia e mantém o mesmo sigilo e cuidado do presencial. Basta um lugar reservado e uma boa conexão.',
  },
  {
    p: 'O que eu falar fica entre nós?',
    r: 'Sim. O sigilo é um dever ético da psicologia, previsto no Código de Ética Profissional. As exceções são raras e previstas em lei, e são sempre conversadas com você.',
  },
  {
    p: 'Quanto tempo dura o tratamento?',
    r: 'Depende de cada pessoa e do que a trouxe. Não existe um número fixo de sessões; vamos avaliando juntos como o processo está caminhando.',
  },
  {
    p: 'Vocês atendem por plano de saúde?',
    r: 'O atendimento é particular. Emito recibo para que você possa solicitar reembolso ao seu plano, conforme as regras do seu contrato.',
  },
];
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">{SITE.slogan} · {SITE.cidade} e online</p>
        <h1>Um lugar para falar do que <em>pesa</em> e cuidar do que importa.</h1>
        <p class="lead">
          Psicoterapia para adultos, adolescentes e casais. Uma escuta atenta e sem julgamentos
          para você entender o que sente e encontrar outros caminhos.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={whatsappLink('Olá! Gostaria de agendar uma primeira conversa.')} target="_blank" rel="noopener">
            Agendar primeira conversa
          </a>
          <a class="btn btn--ghost" href="#como-funciona">Como funciona</a>
        </div>
        <p class="hero__meta">{SITE.profissional} · Psicóloga · {SITE.crp}</p>
      </div>

      <div class="hero__art" aria-hidden="true">
        <svg viewBox="0 0 400 420" fill="none">
          <rect x="30" y="20" width="340" height="380" rx="170" fill="#dfe6dd" />
          <circle cx="200" cy="210" r="120" fill="#efe6d8" />
          <circle cx="200" cy="210" r="120" stroke="#3f5a4c" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
          <circle cx="160" cy="190" r="56" fill="#b4573a" opacity="0.9" />
          <circle cx="240" cy="230" r="56" fill="#3f5a4c" opacity="0.85" />
          <path d="M70 330c60-40 120 30 180-10s80-30 100-20" stroke="#2a2622" stroke-width="2" stroke-linecap="round" />
          <circle cx="310" cy="90" r="10" fill="#b4573a" />
          <circle cx="92" cy="120" r="5" fill="#3f5a4c" />
        </svg>
      </div>
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre" class="section section--alt">
    <div class="wrap sobre">
      <div class="sobre__foto" role="img" aria-label="Espaço para a foto da psicóloga">
        <span>Sua foto aqui</span>
      </div>
      <div>
        <p class="eyebrow">Sobre</p>
        <h2>Olá, eu sou {SITE.profissional}.</h2>
        <p>
          Sou psicóloga clínica ({SITE.crp}) e acredito que cada pessoa carrega um mundo inteiro:
          sua história, seus vínculos, suas dores e suas possibilidades. Foi daí que nasceu o{' '}
          <strong>{SITE.marca}</strong> — um espaço para olhar para esse mundo com calma e cuidado.
        </p>
        <p>
          No consultório, meu trabalho é escutar sem pressa e sem julgamento, ajudando você a dar
          nome ao que sente e a perceber o que se repete na sua vida. A terapia não traz respostas
          prontas; ela abre espaço para que as suas próprias respostas apareçam.
        </p>
        <ul class="formacao">
          <li>Graduação em Psicologia — Instituição</li>
          <li>Especialização / abordagem clínica — Instituição</li>
          <li>Formação complementar — Instituição</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ATENDIMENTO -->
  <section id="atendimento" class="section">
    <div class="wrap">
      <p class="eyebrow">Atendimento</p>
      <h2 class="title-max">Modalidades de atendimento</h2>
      <div class="cards">
        {atendimentos.map((a) => (
          <article class="card">
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </article>
        ))}
      </div>

      <div class="temas">
        <div>
          <h3>Quando procurar terapia?</h3>
          <p>Algumas das questões que costumam chegar ao consultório:</p>
        </div>
        <ul>
          {temas.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-funciona" class="section section--green">
    <div class="wrap">
      <p class="eyebrow">Como funciona</p>
      <h2 class="title-max">Começar é mais simples do que parece.</h2>
      <ol class="passos">
        {passos.map((s) => (
          <li>
            <span class="passos__n">{s.n}</span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section id="duvidas" class="section">
    <div class="wrap faq">
      <div>
        <p class="eyebrow">Dúvidas frequentes</p>
        <h2>Perguntas que muita gente faz antes de começar</h2>
      </div>
      <div class="faq__list">
        {faq.map((f) => (
          <details>
            <summary>{f.p}</summary>
            <p>{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOG -->
  {posts.length > 0 && (
    <section class="section section--alt">
      <div class="wrap">
        <div class="blog-head">
          <div>
            <p class="eyebrow">Blog</p>
            <h2>Textos para pensar com calma</h2>
          </div>
          <a href="/blog/">Ver todos os textos →</a>
        </div>
        <div class="posts">
          {posts.map((post) => (
            <a class="post" href={`/blog/${post.id}/`}>
              <time datetime={post.data.data.toISOString()}>
                {post.data.data.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })}
              </time>
              <h3>{post.data.titulo}</h3>
              <p>{post.data.resumo}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CONTATO -->
  <section id="contato" class="section">
    <div class="wrap contato">
      <div>
        <p class="eyebrow">Contato</p>
        <h2>Vamos conversar?</h2>
        <p class="lead">
          Mande uma mensagem para tirar dúvidas ou agendar sua primeira sessão. Respondo
          pessoalmente, normalmente no mesmo dia.
        </p>
        <a class="btn btn--primary" href={whatsappLink('Olá! Gostaria de agendar uma primeira conversa.')} target="_blank" rel="noopener">
          Chamar no WhatsApp
        </a>
      </div>
      <dl class="contato__info">
        <div><dt>WhatsApp</dt><dd><a href={whatsappLink()} target="_blank" rel="noopener">{telefoneFormatado()}</a></dd></div>
        <div><dt>E-mail</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div><dt>Consultório</dt><dd>{SITE.endereco}<br />{SITE.cidade}/{SITE.uf}</dd></div>
        <div><dt>Horários</dt><dd>{SITE.horario}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 7vw, 5rem); }
  .hero__grid { display: grid; gap: 3rem; align-items: center; }
  .hero h1 em { font-style: italic; color: var(--accent); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 2rem 0 1.5rem; }
  .hero__meta { font-size: 0.9rem; color: var(--ink-soft); }
  .hero__art { max-width: 420px; margin-inline: auto; width: 100%; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 1.25fr 1fr; } }

  .sobre { display: grid; gap: 3rem; align-items: center; }
  .sobre__foto {
    aspect-ratio: 4 / 5; border-radius: 200px 200px var(--radius) var(--radius);
    background: linear-gradient(160deg, #d8c9b3, #c4ad8f);
    display: grid; place-items: center; color: #6e5f4d; font-size: 0.9rem;
    max-width: 380px; width: 100%; margin-inline: auto;
  }
  .formacao { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 1px solid var(--line); }
  .formacao li { padding: 0.7rem 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; color: var(--ink-soft); }
  @media (min-width: 900px) { .sobre { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; } }

  .title-max { max-width: 30ch; }
  .cards { display: grid; gap: 1.2rem; margin-top: 2.5rem; }
  .card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.8rem; transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .card p { color: var(--ink-soft); margin: 0; }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1050px) { .cards { grid-template-columns: repeat(4, 1fr); } }

  .temas {
    display: grid; gap: 1.5rem; margin-top: 4rem; padding: 2.2rem;
    border-radius: var(--radius); background: var(--green-soft);
  }
  .temas ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem 2rem; }
  .temas li { padding-left: 1.4rem; position: relative; }
  .temas li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
  }
  @media (min-width: 800px) {
    .temas { grid-template-columns: 1fr 2fr; padding: 3rem; }
    .temas ul { grid-template-columns: 1fr 1fr; }
  }

  .section--green { background: var(--green); color: #eef1ec; }
  .section--green .eyebrow { color: #f0b9a4; }
  .passos { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; gap: 2.5rem; counter-reset: none; }
  .passos li { border-top: 1px solid rgb(255 255 255 / 0.25); padding-top: 1.5rem; }
  .passos__n { font-family: var(--serif); font-size: 2.6rem; color: #f0b9a4; line-height: 1; display: block; margin-bottom: 1rem; }
  .passos p { color: #d4dcd5; margin: 0; }
  @media (min-width: 800px) { .passos { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  .faq { display: grid; gap: 2rem; }
  .faq__list details { border-bottom: 1px solid var(--line); }
  .faq__list summary {
    cursor: pointer; list-style: none; padding: 1.3rem 2.5rem 1.3rem 0; position: relative;
    font-weight: 600; font-size: 1.05rem;
  }
  .faq__list summary::-webkit-details-marker { display: none; }
  .faq__list summary::after {
    content: '+'; position: absolute; right: 0.3rem; top: 50%; transform: translateY(-50%);
    font-size: 1.6rem; font-weight: 300; color: var(--accent); transition: transform 0.2s;
  }
  .faq__list details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq__list details p { color: var(--ink-soft); padding-bottom: 1.2rem; margin: 0; }
  @media (min-width: 900px) { .faq { grid-template-columns: 1fr 1.6fr; gap: 5rem; } }

  .blog-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; }
  .posts { display: grid; gap: 1.2rem; margin-top: 2rem; }
  .post {
    display: block; padding: 1.8rem; border-radius: var(--radius); background: var(--surface);
    border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: border-color 0.2s;
  }
  .post:hover { border-color: var(--accent); color: var(--ink); }
  .post time { font-size: 0.85rem; color: var(--green); }
  .post h3 { margin: 0.5rem 0; }
  .post p { color: var(--ink-soft); margin: 0; font-size: 0.97rem; }
  @media (min-width: 800px) { .posts { grid-template-columns: repeat(3, 1fr); } }

  .contato { display: grid; gap: 3rem; }
  .contato .lead { margin-bottom: 1.8rem; }
  .contato__info { margin: 0; display: grid; gap: 1.4rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 2rem; }
  .contato__info dt { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--green); font-weight: 600; }
  .contato__info dd { margin: 0.2rem 0 0; }
  @media (min-width: 900px) { .contato { grid-template-columns: 1.2fr 1fr; gap: 5rem; align-items: center; } }
</style>
