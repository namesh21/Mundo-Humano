---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SITE, whatsappLink, telefoneFormatado } from '../config';
import { getCollection } from 'astro:content';
import foto from '../assets/marcel-paulino.webp';
import Faq from '../components/Faq.astro';
import CtaAgenda from '../components/CtaAgenda.astro';
import { faqSchema } from '../seo';

const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);

// Hero: rótulos que a pessoa carrega e como a terapia narrativa os reescreve.
const rotulos = [
  { rotulo: 'o problema', reescrita: 'O problema é o problema. Você não é.' },
  { rotulo: 'demais', reescrita: 'Disseram que você era demais. Talvez a régua é que estivesse errada.' },
  { rotulo: 'difícil', reescrita: 'Algumas coisas estão difíceis. Isso é diferente de ser difícil.' },
  { rotulo: 'frágil', reescrita: 'Sentir muito não é fraqueza. É informação sobre o que importa para você.' },
  { rotulo: 'um fracasso', reescrita: 'Um plano não deu certo. É um capítulo, não o livro inteiro.' },
];

const temas = [
  { titulo: 'Ansiedade e estresse', texto: 'Quando a cabeça não desliga, o corpo cobra e a rotina pesa mais do que deveria.' },
  { titulo: 'Relações e conflitos', texto: 'Casais, famílias e vínculos em que as mesmas brigas e silêncios se repetem.' },
  { titulo: 'Identidade e autoaceitação', texto: 'Gênero, sexualidade, autoestima e o direito de existir sem se explicar.' },
  { titulo: 'Transições e decisões', texto: 'Perdas, separações, mudanças de carreira e escolhas que não dá para adiar.' },
];

const atendimentos = [
  { titulo: 'Psicoterapia individual', texto: 'Adultos e adolescentes, presencial ou online.' },
  { titulo: 'Terapia de casal', texto: 'Casais de todas as formações, em qualquer fase da relação.', link: '/terapia-de-casal-campo-grande/' },
  { titulo: 'Terapia inclusiva e LGBTQIA+', texto: 'Nome, pronomes e história respeitados desde o primeiro contato.', link: '/psicologo-lgbt-campo-grande/' },
  { titulo: 'Terapia familiar', texto: 'Para conviver melhor e atravessar juntos um momento difícil.' },
  { titulo: 'Aconselhamento breve', texto: 'Acompanhamento curto e focado para momentos de crise.' },
  { titulo: 'Grupo terapêutico', texto: 'Grupos conduzidos com terapia narrativa.' },
  { titulo: 'Orientação vocacional e profissional', texto: 'Escolher um curso, mudar de carreira, repensar o trabalho.' },
  { titulo: 'Avaliação psicológica', texto: 'Testes psicológicos e avaliação de candidatos para empresas.' },
];

const trajetoria = [
  { periodo: '2011 até hoje', titulo: 'Consultório particular, Campo Grande' },
  { periodo: '2014 a 2018', titulo: 'Clínica Logus: psicoterapia breve, TCC e terapia narrativa' },
  { periodo: '2013 a 2014', titulo: 'Pestalozzi/MS: psicólogo educacional' },
  { periodo: '2012 a 2020', titulo: 'Instituto KMC: voluntário com famílias em situação de risco' },
  { periodo: '2006 a 2011', titulo: 'Graduação em Psicologia, UCDB' },
];

const passos = [
  { titulo: 'Primeiro contato', texto: 'Pela agenda online você vê os horários livres e os valores. Se tiver dúvidas antes, pode chamar no WhatsApp.' },
  { titulo: 'Primeira sessão', texto: 'Entendemos juntos o que te trouxe, o contexto e o que você espera da terapia. Eu explico como trabalho.' },
  { titulo: 'O processo', texto: 'Os objetivos são construídos em conjunto e revistos pelo caminho, respeitando o seu ritmo.' },
];

const faq = [
  { p: 'Como faço para agendar?', r: 'Pela agenda online você vê os horários livres, os valores e agenda direto. Se tiver dúvidas antes, é só chamar no WhatsApp.' },
  { p: 'O atendimento é presencial ou online?', r: 'Os dois. Presencial no consultório do Jardim Bela Vista, em Campo Grande, às terças, quintas, sextas e sábados. Online de segunda a sábado, para qualquer cidade.' },
  { p: 'Como funciona a primeira sessão?', r: 'É uma conversa para entender o que te traz e o seu contexto. Não é preciso chegar com nada organizado. Ao final, combinamos juntos os próximos passos.' },
  { p: 'Como funciona a confidencialidade?', r: 'O sigilo é um dever ético do psicólogo, previsto no Código de Ética Profissional. As exceções são raras, previstas em lei, e sempre conversadas com você.' },
  { p: 'Quais são as formas de pagamento?', r: 'Dinheiro, Pix e cartão de crédito ou débito. Os valores das sessões ficam na agenda online.' },
  { p: 'Preciso estar em crise para começar?', r: 'Não. Muita gente procura terapia para se conhecer melhor, atravessar uma mudança ou entender padrões que se repetem. Você não precisa ter todas as respostas para começar.' },
];
---
<Base schema={[faqSchema(faq)]}>
  <!-- HERO -->
  <section class="hero" aria-labelledby="titulo">
    <div class="wrap hero__grid">
      <div class="hero__principal">
        <h1 id="titulo" class="eyebrow hero__id">Marcel Paulino, psicólogo clínico em Campo Grande</h1>

        <div class="reescrita" data-reescrita>
          <p class="reescrita__frase">
            Eu sou <span class="riscado-linha"><span class="riscado" data-rotulo>{rotulos[0].rotulo}</span>.</span>
          </p>
          <p class="reescrita__nova" data-nova aria-live="polite">{rotulos[0].reescrita}</p>
        </div>

        <div class="rotulos" role="group" aria-label="Escolha um rótulo para reescrever">
          <span class="rotulos__legenda">Outros rótulos que a gente carrega</span>
          {rotulos.map((r, i) => (
            <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}>{r.rotulo}</button>
          ))}
        </div>
      </div>

      <div class="hero__lado">
        <p class="hero__proposta">
          Psicoterapia individual, de casal e familiar com terapia narrativa e TCC.
          Um espaço para pensar com clareza, sem julgamento e sem ninguém dizendo o que é certo.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={SITE.agenda} target="_blank" rel="noopener">Agendar consulta</a>
          <a class="link-sec" href="#abordagem">Conheça a abordagem</a>
        </div>
        <ul class="hero__sinais">
          <li>Sigilo profissional</li>
          <li>Presencial e online</li>
          <li>{SITE.crp}</li>
        </ul>
      </div>
    </div>
    <script type="application/json" id="rotulos-data" set:html={JSON.stringify(rotulos)} />
  </section>

  <!-- TEMAS -->
  <section class="temas" aria-labelledby="temas-titulo">
    <div class="wrap">
      <h2 id="temas-titulo" class="temas__titulo">Quando a terapia pode ajudar</h2>
      <ul class="temas__lista">
        {temas.map((t) => (
          <li>
            <h3>{t.titulo}</h3>
            <p>{t.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre" class="section sobre">
    <div class="wrap sobre__grid">
      <figure class="retrato">
        <Image src={foto} alt="Marcel Paulino, psicólogo em Campo Grande" widths={[440, 660]} sizes="(min-width: 900px) 440px, 90vw" />
        <figcaption>Marcel Paulino, {SITE.crp}</figcaption>
      </figure>
      <div class="sobre__texto">
        <p class="eyebrow">Sobre</p>
        <h2>Troquei a lógica dos números pela <em>subjetividade humana</em>.</h2>
        <p class="lead">
          Ouvir pessoas é uma paixão que vem da adolescência. Deixei três anos de Ciência da
          Computação para cursar Psicologia na UCDB, e sou psicólogo clínico desde 2011.
        </p>
        <p>
          Sou casado, pai da Lara e da Zoe, e dos pets Sexta-Feira e Thyka. No consultório, trabalho
          com jovens, adultos, casais e famílias para que cada pessoa se reconheça especialista da
          própria vida. Acredito na terapia como uma ferramenta de construção do ser, feita sem
          julgamento.
        </p>
        <ol class="trajetoria" aria-label="Formação e trajetória">
          {trajetoria.map((t) => (
            <li><span>{t.periodo}</span>{t.titulo}</li>
          ))}
        </ol>
        <a class="link-sec" href={SITE.linkedin} target="_blank" rel="noopener">Perfil completo no LinkedIn</a>
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="section section--escura manifesto">
    <div class="wrap manifesto__grid">
      <h2>Aqui ninguém precisa <em>se explicar</em>.</h2>
      <div>
        <p>
          Atendo todas as pessoas, de qualquer identidade de gênero, orientação sexual, idade ou
          história de vida. Seu nome e seus pronomes são respeitados desde o primeiro contato, e
          orientação ou identidade nunca são tratadas como algo a corrigir.
        </p>
        <a class="link-sec" href="/psicologo-lgbt-campo-grande/">Sobre o atendimento inclusivo e LGBTQIA+</a>
      </div>
    </div>
  </section>

  <!-- ABORDAGEM -->
  <section id="abordagem" class="section">
    <div class="wrap">
      <div class="abordagem__topo">
        <p class="eyebrow">Abordagem</p>
        <h2>Duas lentes para a mesma história.</h2>
      </div>
      <div class="abordagem__cols">
        <div>
          <h3>Terapia narrativa</h3>
          <p>
            Olha para as histórias que você conta sobre si e que contaram sobre você. Separa a pessoa
            do problema e abre espaço para reescrever o que já não te representa.
          </p>
        </div>
        <div>
          <h3>Terapia cognitivo-comportamental</h3>
          <p>
            Baseada em evidências, identifica pensamentos e padrões de comportamento que fazem mal e
            constrói estratégias práticas para o dia a dia.
          </p>
        </div>
        <div>
          <h3>Escuta e vínculo</h3>
          <p>
            Nenhuma técnica funciona sem uma relação de confiança. Os objetivos são definidos em
            conjunto e revistos pelo caminho, sem promessas e no seu ritmo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ATENDIMENTOS -->
  <section id="atendimento" class="section section--pedra">
    <div class="wrap atendimentos">
      <div>
        <p class="eyebrow">Atendimentos</p>
        <h2>O que eu atendo.</h2>
        <p class="atendimentos__nota">
          Todos os formatos também acontecem online, de segunda a sábado, conforme as normas do CFP
          e do CRP-14/MS.
        </p>
      </div>
      <ul class="indice">
        {atendimentos.map((a) => (
          <li class:list={['indice__item', { 'indice__item--link': a.link }]}>
            <h3>{a.link ? <a href={a.link}>{a.titulo}</a> : a.titulo}</h3>
            <p>{a.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-funciona" class="section">
    <div class="wrap">
      <p class="eyebrow">Como funciona</p>
      <h2 class="passos__titulo">Você não precisa ter todas as respostas para começar.</h2>
      <ol class="passos">
        {passos.map((s, i) => (
          <li>
            <span class="passos__n" aria-hidden="true">{i + 1}</span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ARTIGOS -->
  {posts.length > 0 && (
    <section class="section section--pedra">
      <div class="wrap">
        <h2>Artigos</h2>
        <ul class="indice">
          {posts.map((post) => (
            <li class="indice__item indice__item--link">
              <h3><a href={`/blog/${post.id}/`}>{post.data.titulo}</a></h3>
              <p>{post.data.resumo}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section id="duvidas" class="section section--tight">
    <div class="wrap faq">
      <div>
        <p class="eyebrow">Dúvidas</p>
        <h2>Antes de começar.</h2>
      </div>
      <Faq itens={faq} />
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato" class="section section--pedra contato">
    <div class="wrap contato__grid">
      <div>
        <p class="eyebrow">Contato</p>
        <h2>Consultório no Jardim Bela Vista.</h2>
        <p class="lead">E atendimento online para qualquer cidade.</p>
      </div>
      <dl class="contato__info">
        <div><dt>Agenda online</dt><dd><a href={SITE.agenda} target="_blank" rel="noopener" class="quebra">{SITE.agenda.replace('https://', '')}</a></dd></div>
        <div><dt>WhatsApp e telefone</dt><dd><a href={whatsappLink()} target="_blank" rel="noopener">{telefoneFormatado()}</a></dd></div>
        <div><dt>E-mail</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div>
          <dt>Endereço</dt>
          <dd><a href={SITE.mapa} target="_blank" rel="noopener">{SITE.endereco}<br />{SITE.bairro}, {SITE.cidade}/{SITE.uf}</a></dd>
        </div>
        <div>
          <dt>Horários</dt>
          <dd>Presencial: {SITE.horarios.presencial.toLowerCase()}<br />Online: {SITE.horarios.online.toLowerCase()}<br />{SITE.horarios.domingo}</dd>
        </div>
        <div><dt>Pagamento</dt><dd>{SITE.pagamento}</dd></div>
        <div><dt>Parceiros</dt><dd>{SITE.parceiros.join(' e ')}</dd></div>
      </dl>
    </div>
  </section>

  <CtaAgenda />
</Base>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-reescrita]');
  const dados = JSON.parse(document.getElementById('rotulos-data')?.textContent || '[]') as { rotulo: string; reescrita: string }[];
  const rotulo = raiz?.querySelector<HTMLElement>('[data-rotulo]');
  const nova = raiz?.querySelector<HTMLElement>('[data-nova]');
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function mostrar(i: number) {
    if (!raiz || !rotulo || !nova || !dados[i]) return;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.i) === i)));
    if (semMovimento) {
      rotulo.textContent = dados[i].rotulo;
      nova.textContent = dados[i].reescrita;
      raiz.classList.add('is-riscado', 'is-reescrito');
      return;
    }
    raiz.classList.remove('is-riscado', 'is-reescrito');
    window.setTimeout(() => {
      rotulo.textContent = dados[i].rotulo;
      nova.textContent = dados[i].reescrita;
      window.setTimeout(() => raiz.classList.add('is-riscado'), 300);
      window.setTimeout(() => raiz.classList.add('is-reescrito'), 950);
    }, 220);
  }

  chips.forEach((c) => c.addEventListener('click', () => mostrar(Number(c.dataset.i))));
  if (raiz) {
    raiz.classList.add('js');
    mostrar(0);
  }
</script>

<style>
  /* HERO */
  .hero { background: var(--oliva); color: var(--marfim); padding: clamp(3rem, 7vw, 6rem) 0 clamp(3.5rem, 7vw, 6rem); }
  .hero__grid { display: grid; gap: 3rem; }
  .hero__id { font-family: var(--sans); margin-bottom: 0; }

  .reescrita { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(1.8rem, 4vw, 2.8rem); }
  .reescrita__frase {
    font-family: var(--serif); font-weight: 400; line-height: 0.95; letter-spacing: -0.02em;
    font-size: clamp(2.7rem, 9.2vw, 7.8rem); margin: 0;
  }
  .riscado-linha { display: block; white-space: nowrap; }
  .riscado { position: relative; display: inline-block; transition: color 0.6s; }
  .riscado::after {
    content: ''; position: absolute; left: -0.03em; right: -0.03em; top: 55%;
    height: 0.045em; min-height: 2px; background: var(--ipe);
    transform: scaleX(1) rotate(-3deg); transform-origin: left center;
  }
  .js .riscado::after { transform: scaleX(0) rotate(-3deg); transition: transform 0.6s cubic-bezier(0.7, 0, 0.2, 1); }
  .js.is-riscado .riscado::after { transform: scaleX(1) rotate(-3deg); }
  .js.is-riscado .riscado { color: #8a8575; }

  .reescrita__nova {
    font-family: var(--serif); font-style: italic; font-weight: 400; line-height: 1.15;
    font-size: clamp(1.55rem, 3.4vw, 2.7rem); color: var(--ouro-claro); max-width: 24ch; margin: 1.6rem 0 0; min-height: 2.3em;
  }
  .js .reescrita__nova { opacity: 0; transform: translateY(0.25em); transition: opacity 0.6s, transform 0.6s; }
  .js.is-reescrito .reescrita__nova { opacity: 1; transform: none; }

  .rotulos { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1.3rem; }
  .rotulos__legenda { color: #9d968a; font-size: 0.9rem; flex-basis: 100%; margin-bottom: 0.2rem; }
  .chip {
    min-height: 44px; padding: 0.4rem 0; cursor: pointer; background: none; border: 0;
    color: var(--texto-claro); font: italic 400 1.35rem var(--serif);
    text-decoration: underline; text-decoration-color: rgb(243 239 231 / 0.25); text-underline-offset: 6px; text-decoration-thickness: 1px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .chip:hover { color: var(--marfim); text-decoration-color: var(--marfim); }
  .chip[aria-pressed='true'] { color: var(--ipe); text-decoration-color: var(--ipe); }

  .hero__lado { display: grid; gap: 1.8rem; align-content: end; }
  .hero__proposta { font-size: 1.12rem; line-height: 1.7; color: var(--texto-claro); margin: 0; max-width: 30rem; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
  .hero__sinais { list-style: none; margin: 0; padding: 1.3rem 0 0; border-top: 1px solid var(--linha-escura); display: grid; gap: 0.35rem; font-size: 0.88rem; color: #9d968a; }
  .hero__sinais li { padding-left: 1.1rem; position: relative; }
  .hero__sinais li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 0.55rem; height: 1px; background: var(--ouro); }
  @media (min-width: 1000px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr) 21rem; gap: 4rem; align-items: end; }
  }

  /* TEMAS */
  .temas { background: var(--marfim); padding: clamp(4rem, 8vw, 6rem) 0; border-bottom: 1px solid var(--linha); }
  .temas__titulo { font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 2.5rem; }
  .temas__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .temas__lista li { padding: 1.5rem 0; border-top: 1px solid var(--linha); }
  .temas__lista h3 { font-size: 1.45rem; margin-bottom: 0.5rem; }
  .temas__lista p { margin: 0; color: var(--tinta-suave); font-size: 0.98rem; }
  @media (min-width: 900px) {
    .temas__lista { grid-template-columns: repeat(4, 1fr); }
    .temas__lista li { padding: 0.4rem 2rem 0 0; border-top: 0; border-left: 1px solid var(--linha); padding-left: 1.6rem; }
    .temas__lista li:first-child { border-left: 0; padding-left: 0; }
  }

  /* SOBRE */
  .sobre__grid { display: grid; gap: 3.5rem; align-items: start; }
  .retrato { margin: 0; max-width: 440px; width: 100%; }
  .retrato :global(img) {
    width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover;
    filter: grayscale(1) sepia(0.18) contrast(1.05) brightness(1.02);
  }
  .retrato figcaption { margin-top: 0.8rem; font-size: 0.85rem; color: var(--tinta-suave); }
  .sobre h2 { font-size: clamp(2.2rem, 4.4vw, 3.5rem); max-width: 16ch; }
  .sobre h2 em { color: var(--ouro); }
  .sobre__texto > p { max-width: 36rem; }
  .sobre__texto > p:not(.lead):not(.eyebrow) { color: var(--tinta-suave); }
  .trajetoria { list-style: none; margin: 2.5rem 0 2rem; padding: 0; border-top: 1px solid var(--tinta); max-width: 36rem; }
  .trajetoria li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--linha); font-size: 0.95rem; }
  .trajetoria span { color: var(--ouro); font-weight: 600; }
  @media (min-width: 900px) { .sobre__grid { grid-template-columns: 440px 1fr; gap: 7rem; } .retrato { position: sticky; top: 120px; } }

  /* MANIFESTO */
  .manifesto__grid { display: grid; gap: 2rem 6rem; align-items: end; }
  .manifesto h2 { font-size: clamp(2.6rem, 6vw, 5rem); line-height: 1; margin: 0; max-width: 12ch; }
  .manifesto h2 em { color: var(--ipe); }
  .manifesto p { color: var(--texto-claro); font-size: 1.1rem; max-width: 32rem; }
  .manifesto .link-sec { color: var(--marfim); }
  @media (min-width: 900px) { .manifesto__grid { grid-template-columns: 1.3fr 1fr; } }

  /* ABORDAGEM */
  .abordagem__topo h2 { max-width: 14ch; }
  .abordagem__cols { display: grid; gap: 2.5rem; margin-top: 3rem; }
  .abordagem__cols h3 { font-size: 1.6rem; }
  .abordagem__cols p { color: var(--tinta-suave); margin: 0; }
  .abordagem__cols > div { border-top: 1px solid var(--tinta); padding-top: 1.4rem; }
  @media (min-width: 900px) { .abordagem__cols { grid-template-columns: repeat(3, 1fr); gap: 3.5rem; } }

  /* ATENDIMENTOS */
  .atendimentos { display: grid; gap: 2.5rem; }
  .atendimentos__nota { color: var(--tinta-suave); max-width: 22rem; font-size: 0.97rem; }
  .indice { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--tinta); }
  .indice__item { display: grid; gap: 0.2rem; padding: 1.2rem 0; border-bottom: 1px solid var(--linha); position: relative; }
  .indice__item h3 { font-size: clamp(1.4rem, 2.3vw, 1.85rem); margin: 0; }
