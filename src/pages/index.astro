---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SITE, whatsappLink, telefoneFormatado } from '../config';
import { getCollection } from 'astro:content';
import foto from '../assets/marcel-paulino.webp';
import Faq from '../components/Faq.astro';
import { faqSchema } from '../seo';

const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);

// Hero: rótulos que a pessoa carrega e como a terapia narrativa os reescreve.
const rotulos = [
  { rotulo: 'o problema', reescrita: 'O problema é o problema. Você não é.' },
  { rotulo: 'demais', reescrita: 'Te disseram que você era demais. E se a régua é que estava errada?' },
  { rotulo: 'difícil', reescrita: 'Algumas coisas estão difíceis. Isso é bem diferente de ser difícil.' },
  { rotulo: 'frágil', reescrita: 'Sentir muito não é fraqueza. É informação sobre o que importa pra você.' },
  { rotulo: 'um fracasso', reescrita: 'Um plano não deu certo. É um capítulo, não o livro inteiro.' },
];

const atendimentos = [
  { titulo: 'Psicoterapia individual', texto: 'Para adultos e adolescentes que querem entender o que sentem e mudar o que não serve mais.' },
  { titulo: 'Terapia de casal', texto: 'Para casais de todas as formações olharem juntos para a comunicação, os conflitos e o que se repete.', link: '/terapia-de-casal-campo-grande/' },
  { titulo: 'Terapia inclusiva e LGBTQIA+', texto: 'Atendimento afirmativo: seu nome, seus pronomes e sua história respeitados desde o primeiro contato.', link: '/psicologo-lgbt-campo-grande/' },
  { titulo: 'Terapia familiar', texto: 'Para famílias que querem conviver melhor e atravessar juntas um momento difícil.' },
  { titulo: 'Aconselhamento breve', texto: 'Acompanhamento curto e focado para momentos de crise: perdas, separações, decisões urgentes.' },
  { titulo: 'Grupo terapêutico', texto: 'Grupos conduzidos com terapia narrativa, onde histórias parecidas se encontram.' },
  { titulo: 'Orientação vocacional e profissional', texto: 'Para escolher um curso, mudar de carreira ou repensar o trabalho com mais clareza.' },
  { titulo: 'Avaliação psicológica', texto: 'Aplicação de testes e avaliação de candidatos para empresas em processos seletivos.' },
];

const temas = [
  'ansiedade',
  'depressão e humor',
  'estresse',
  'fobias e medos',
  'relacionamentos',
  'comunicação',
  'autoestima',
  'autoaceitação',
  'hábitos e vícios',
  'luto',
  'identidade',
  'carreira',
];

const trajetoria = [
  { periodo: '2011 até hoje', titulo: 'Consultório particular', texto: 'Psicoterapia individual, de casal e familiar, grupos, orientação vocacional e avaliação psicológica.' },
  { periodo: '2014 a 2018', titulo: 'Clínica Logus', texto: 'Psicoterapia breve, TCC e terapia narrativa com indivíduos, casais e famílias.' },
  { periodo: '2013 a 2014', titulo: 'Pestalozzi/MS', texto: 'Psicólogo educacional na equipe de orientação escolar.' },
  { periodo: '2012 a 2020', titulo: 'Instituto KMC, voluntário', texto: 'Famílias em situação de risco encaminhadas por Fórum, Ministério Público, CREAS, CRAS e Conselho Tutelar.' },
  { periodo: '2006 a 2011', titulo: 'Psicologia na UCDB', texto: 'Graduação com ênfase em psicologia clínica.' },
];

const passos = [
  { titulo: 'Escolha um horário', texto: 'Na agenda online você vê os horários livres e os valores, e já marca. Se preferir, chama no WhatsApp.' },
  { titulo: 'Primeira conversa', texto: 'A gente entende o que te trouxe, eu explico como trabalho e definimos juntos por onde começar.' },
  { titulo: 'O processo', texto: 'Sessões presenciais em Campo Grande ou online, no seu ritmo, revendo os objetivos pelo caminho.' },
];

const faq = [
  { p: 'Como faço para agendar?', r: 'Pela agenda online você vê os horários livres, os valores e agenda direto. Se tiver dúvidas antes, é só chamar no WhatsApp.' },
  { p: 'Quais são as formas de pagamento?', r: 'Dinheiro, Pix e cartão de crédito ou débito. Os valores das sessões ficam na agenda online.' },
  { p: 'Preciso estar em crise para começar?', r: 'Não. Muita gente procura terapia para se conhecer melhor, atravessar uma mudança ou entender padrões que se repetem. Você é especialista da sua vida; a terapia é uma ferramenta para construir esse caminho.' },
  { p: 'A terapia online funciona?', r: 'Sim. O atendimento online é regulamentado pelo Conselho Federal de Psicologia e tem o mesmo sigilo do presencial. Basta um lugar reservado e uma boa conexão.' },
  { p: 'O que eu falar fica entre nós?', r: 'Sim. O sigilo é um dever ético do psicólogo, previsto no Código de Ética Profissional. As exceções são raras, previstas em lei, e sempre conversadas com você.' },
  { p: 'Quanto tempo dura?', r: 'Depende do que te traz. O aconselhamento breve é curto e focado; a psicoterapia trabalha com objetivos definidos em conjunto, que vamos revendo pelo caminho.' },
];
---
<Base schema={[faqSchema(faq)]}>
  <!-- HERO: rótulos reescritos -->
  <section class="hero" aria-labelledby="titulo">
    <div class="wrap">
      <div class="hero__topo">
        <h1 id="titulo">Marcel Paulino, psicólogo em Campo Grande</h1>
        <p>Terapia narrativa e TCC, presencial e online. {SITE.crp}</p>
      </div>

      <div class="reescrita" data-reescrita>
        <p class="reescrita__frase">
          Eu sou <span class="riscado-linha"><span class="riscado" data-rotulo>{rotulos[0].rotulo}</span>.</span>
        </p>
        <p class="reescrita__nova" data-nova aria-live="polite">{rotulos[0].reescrita}</p>
      </div>

      <div class="hero__base">
        <div class="rotulos" role="group" aria-label="Escolha um rótulo para reescrever">
          <p class="rotulos__legenda">Outros rótulos que a gente carrega:</p>
          <div class="rotulos__lista">
            {rotulos.map((r, i) => (
              <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}>{r.rotulo}</button>
            ))}
          </div>
        </div>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={SITE.agenda} target="_blank" rel="noopener">Agendar consulta</a>
          <a class="btn btn--claro" href={whatsappLink()} target="_blank" rel="noopener">Conversar no WhatsApp</a>
        </div>
      </div>
      <p class="hero__nota">
        Na terapia narrativa, a pessoa não é o problema. Separar uma coisa da outra é onde a sua
        história começa a mudar.
      </p>
    </div>
    <script type="application/json" id="rotulos-data" set:html={JSON.stringify(rotulos)} />
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto">
    <div class="wrap manifesto__grid">
      <h2>Aqui ninguém precisa se explicar.</h2>
      <div>
        <p class="lead">
          Atendo todas as pessoas, de qualquer identidade de gênero, orientação sexual, idade ou
          história de vida. Sem julgamento e sem dizer o que é certo ou errado: quem conhece a sua
          vida é você.
        </p>
        <a class="link-forte" href="/psicologo-lgbt-campo-grande/">Como funciona o atendimento inclusivo e LGBTQIA+</a>
      </div>
    </div>
  </section>

  <!-- ATENDIMENTOS -->
  <section id="atendimento" class="section">
    <div class="wrap">
      <h2 class="titulo-secao">O que eu atendo</h2>
      <ul class="indice">
        {atendimentos.map((a) => (
          <li class:list={['indice__item', { 'indice__item--link': a.link }]}>
            <h3>{a.link ? <a href={a.link}>{a.titulo}</a> : a.titulo}</h3>
            <p>{a.texto}</p>
          </li>
        ))}
      </ul>
      <p class="online">
        Todos os atendimentos também acontecem <strong>online</strong>, de segunda a sábado, conforme as normas do CFP e do CRP-14/MS.
      </p>

      <div class="temas">
        <h3>Questões que chegam ao consultório</h3>
        <p class="temas__lista">
          {temas.map((t) => <span>{t}</span>)}
        </p>
      </div>
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre" class="sobre">
    <div class="wrap sobre__grid">
      <figure class="duotone">
        <Image src={foto} alt="Marcel Paulino, psicólogo em Campo Grande" widths={[420, 640]} sizes="(min-width: 900px) 420px, 90vw" />
      </figure>
      <div class="sobre__texto">
        <h2>Olá, sou Marcel.</h2>
        <p>
          Sou casado, pai da Lara e da Zoe, e dos pets Sexta-Feira e Thyka. Ouvir pessoas é uma
          paixão que vem da adolescência e que se confirmou quando decidi cursar Psicologia.
        </p>
        <p>
          Deixei para trás três anos de Ciência da Computação e troquei a lógica dos números pela
          subjetividade humana. Sou psicólogo clínico desde 2011, formado pela UCDB, e trabalho com
          jovens, adultos, casais e famílias para que cada um se reconheça especialista da própria vida.
        </p>
        <p class="sobre__crp">{SITE.crp}, psicólogo clínico</p>
        <a class="link-forte" href={SITE.linkedin} target="_blank" rel="noopener">Perfil completo no LinkedIn</a>
      </div>
    </div>
    <div class="wrap">
      <ol class="linha-do-tempo" aria-label="Formação e trajetória">
        {trajetoria.map((t) => (
          <li>
            <span class="linha-do-tempo__ano">{t.periodo}</span>
            <h3>{t.titulo}</h3>
            <p>{t.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ABORDAGEM -->
  <section id="abordagem" class="section section--lilas">
    <div class="wrap abordagem">
      <h2>Duas lentes para a mesma história</h2>
      <div class="abordagem__col">
        <h3>Terapia narrativa</h3>
        <p>
          Olha para as histórias que você conta sobre si e que contaram sobre você. Separa a pessoa
          do problema e abre espaço para reescrever o que já não te representa.
        </p>
      </div>
      <div class="abordagem__col">
        <h3>Terapia cognitivo-comportamental</h3>
        <p>
          Baseada em evidências, identifica pensamentos e padrões de comportamento que fazem mal e
          constrói estratégias práticas para o dia a dia.
        </p>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-funciona" class="section">
    <div class="wrap">
      <h2 class="titulo-secao">Como começar</h2>
      <ol class="passos">
        {passos.map((s, i) => (
          <li>
            <span class="passos__n" aria-hidden="true">{i + 1}</span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section id="duvidas" class="section section--tight">
    <div class="wrap faq">
      <h2>Antes de começar</h2>
      <Faq itens={faq} />
    </div>
  </section>

  <!-- BLOG -->
  {posts.length > 0 && (
    <section class="section section--lilas">
      <div class="wrap">
        <h2 class="titulo-secao">Textos</h2>
        <ul class="indice">
          {posts.map((post) => (
            <li class="indice__item indice__item--link">
              <h3><a href={`/blog/${post.id}/`}>{post.data.titulo}</a></h3>
              <p>{post.data.resumo}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- CONTATO -->
  <section id="contato" class="contato">
    <div class="wrap contato__grid">
      <div>
        <h2>Marque a sua primeira conversa.</h2>
        <p class="contato__lead">Os horários livres e os valores estão na agenda online.</p>
        <div class="contato__ctas">
          <a class="btn btn--tinta" href={SITE.agenda} target="_blank" rel="noopener">Agendar consulta</a>
          <a class="btn btn--ghost" href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a>
        </div>
        <p class="contato__url">
          Agenda online: <a href={SITE.agenda} target="_blank" rel="noopener">{SITE.agenda.replace('https://', '')}</a>
        </p>
      </div>
      <dl class="contato__info">
        <div><dt>WhatsApp e telefone</dt><dd><a href={whatsappLink()} target="_blank" rel="noopener">{telefoneFormatado()}</a></dd></div>
        <div><dt>E-mail</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div>
          <dt>Consultório</dt>
          <dd><a href={SITE.mapa} target="_blank" rel="noopener">{SITE.endereco}<br />{SITE.bairro}, {SITE.cidade}/{SITE.uf}</a></dd>
        </div>
        <div>
          <dt>Horários</dt>
          <dd>Presencial: {SITE.horarios.presencial.toLowerCase()}<br />Online: {SITE.horarios.online.toLowerCase()}<br />{SITE.horarios.domingo}</dd>
        </div>
        <div><dt>Pagamento</dt><dd>{SITE.pagamento}</dd></div>
        <div><dt>Parceiros</dt><dd>{SITE.parceiros.join(' e ')}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-reescrita]');
  const dados = JSON.parse(document.getElementById('rotulos-data')?.textContent || '[]') as { rotulo: string; reescrita: string }[];
  const rotulo = raiz?.querySelector<HTMLElement>('[data-rotulo]');
  const nova = raiz?.querySelector<HTMLElement>('[data-nova]');
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function mostrar(i: number) {
    if (!raiz || !rotulo || !nova || !dados[i]) return;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.i) === i)));
    if (semMovimento) {
      rotulo.textContent = dados[i].rotulo;
      nova.textContent = dados[i].reescrita;
      raiz.classList.add('is-riscado', 'is-reescrito');
      return;
    }
    raiz.classList.remove('is-riscado', 'is-reescrito');
    window.setTimeout(() => {
      rotulo.textContent = dados[i].rotulo;
      nova.textContent = dados[i].reescrita;
      window.setTimeout(() => raiz.classList.add('is-riscado'), 250);
      window.setTimeout(() => raiz.classList.add('is-reescrito'), 850);
    }, 200);
  }

  chips.forEach((c) => c.addEventListener('click', () => mostrar(Number(c.dataset.i))));
  if (raiz) {
    raiz.classList.add('js');
    mostrar(0);
  }
</script>

<style>
  /* HERO */
  .hero { background: var(--cobalto); color: #fff; padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 6vw, 4.5rem); }
  .hero__topo { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 2rem; align-items: baseline; padding-bottom: 1.2rem; border-bottom: 1px solid rgb(255 255 255 / 0.25); }
  .hero__topo h1 { font-size: clamp(1.15rem, 2vw, 1.45rem); letter-spacing: -0.01em; margin: 0; color: #fff; }
  .hero__topo p { margin: 0; color: #b8c0f2; font-size: 0.98rem; }

  .reescrita { padding: clamp(3rem, 9vw, 6.5rem) 0 clamp(2rem, 5vw, 3.5rem); min-height: clamp(14rem, 40vw, 30rem); }
  .reescrita__frase {
    font-family: var(--display); font-weight: 800; letter-spacing: -0.045em; line-height: 0.92;
    font-size: clamp(2.3rem, 9.4vw, 7.6rem); margin: 0; color: #fff;
  }
  .riscado-linha { display: block; white-space: nowrap; }
  .riscado { position: relative; display: inline-block; white-space: nowrap; transition: color 0.5s; }
  .riscado::after {
    content: ''; position: absolute; left: -0.04em; right: -0.04em; top: 52%;
    height: 0.11em; background: var(--ipe); border-radius: 0.06em;
    transform: scaleX(1) rotate(-2deg); transform-origin: left center;
  }
  .js .riscado::after { transform: scaleX(0) rotate(-2deg); transition: transform 0.55s cubic-bezier(0.7, 0, 0.2, 1); }
  .js.is-riscado .riscado::after { transform: scaleX(1) rotate(-2deg); }
  .js.is-riscado .riscado { color: #8c98e6; }

  .reescrita__nova {
    font-family: var(--display); font-weight: 600; letter-spacing: -0.025em; line-height: 1.08;
    font-size: clamp(1.6rem, 4.2vw, 3.4rem); color: var(--caninde); max-width: 22ch; margin: 1.6rem 0 0;
  }
  .js .reescrita__nova { opacity: 0; transform: translateY(0.3em); transition: opacity 0.5s, transform 0.5s; }
  .js.is-reescrito .reescrita__nova { opacity: 1; transform: none; }

  .hero__base { display: grid; gap: 2rem; align-items: end; }
  .rotulos__legenda { margin: 0 0 0.7rem; color: #b8c0f2; font-size: 0.98rem; }
  .rotulos__lista { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-height: 44px; padding: 0.5rem 1.1rem; border-radius: 999px; cursor: pointer;
    background: transparent; color: #fff; border: 2px solid rgb(255 255 255 / 0.45);
    font: 600 1rem var(--display); letter-spacing: -0.01em; transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .chip:hover { border-color: #fff; }
  .chip[aria-pressed='true'] { background: var(--ipe); border-color: var(--ipe); color: var(--tinta); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .hero__nota { margin: 2.5rem 0 0; color: #b8c0f2; max-width: 36rem; font-size: 0.98rem; }
  @media (min-width: 900px) {
    .hero__base { grid-template-columns: 1fr auto; }
  }

  /* MANIFESTO */
  .manifesto { background: var(--ipe); color: var(--tinta); padding: clamp(3.5rem, 8vw, 6rem) 0; }
  .manifesto__grid { display: grid; gap: 1.5rem 5rem; align-items: start; }
  .manifesto h2 { font-size: clamp(2.4rem, 6vw, 4.6rem); font-weight: 800; letter-spacing: -0.04em; margin: 0; }
  .manifesto .lead { color: var(--tinta); }
  .link-forte { font-family: var(--display); font-weight: 700; color: inherit; text-decoration-thickness: 2px; }
  .manifesto .link-forte:hover { color: var(--cobalto); }
  @media (min-width: 900px) { .manifesto__grid { grid-template-columns: 1.2fr 1fr; } }

  /* ÍNDICE DE ATENDIMENTOS */
  .titulo-secao { margin-bottom: 2.5rem; }
  .indice { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--tinta); }
  .indice__item { display: grid; gap: 0.4rem; padding: 1.5rem 0; border-bottom: 1px solid var(--linha); position: relative; }
  .indice__item h3 { font-size: clamp(1.5rem, 3vw, 2.3rem); letter-spacing: -0.03em; margin: 0; }
  .indice__item p { margin: 0; color: var(--tinta-suave); max-width: 36rem; }
  .indice__item h3 a { color: var(--tinta); text-decoration: none; }
  .indice__item h3 a::after { content: ''; position: absolute; inset: 0; }
  .indice__item--link h3 a { background: linear-gradient(var(--ipe), var(--ipe)) 0 92% / 100% 0.14em no-repeat; }
  .indice__item--link:hover h3 a { color: var(--cobalto); }
  @media (min-width: 900px) {
    .indice__item { grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: baseline; padding: 1.7rem 0; }
  }
  .online { margin: 2rem 0 0; color: var(--tinta-suave); }

  .temas { margin-top: clamp(4rem, 8vw, 6rem); }
  .temas h3 { font-size: 1.15rem; color: var(--tinta-suave); font-weight: 600; }
  .temas__lista { display: flex; flex-wrap: wrap; font-family: var(--display); font-weight: 700; font-size: clamp(1.7rem, 4.4vw, 3.3rem); line-height: 1.12; letter-spacing: -0.035em; margin: 0; color: var(--cobalto); }
  .temas__lista span:not(:last-child)::after { content: '/'; color: var(--ipe); margin: 0 0.28em; font-weight: 400; }

  /* SOBRE */
  .sobre { background: var(--tinta); color: #e9e6f6; padding: clamp(4.5rem, 10vw, 8rem) 0; }
  .sobre__grid { display: grid; gap: 3rem; align-items: center; }
  .sobre h2 { color: #fff; font-size: clamp(2.6rem, 6vw, 4.4rem); font-weight: 800; letter-spacing: -0.04em; }
  .sobre__texto p { color: #c9c6e0; max-width: 34rem; }
  .sobre__texto .sobre__crp { font-family: var(--display); font-weight: 700; color: var(--caninde); margin-top: 1.5rem; }
  .sobre .link-forte { color: #fff; }
  .sobre .link-forte:hover { color: var(--ipe); }

  .duotone { margin: 0; position: relative; background: var(--ipe); max-width: 420px; width: 100%; border-radius: 210px 210px 24px 24px; overflow: hidden; isolation: isolate; }
  .duotone :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; filter: grayscale(1) contrast(1.15); mix-blend-mode: multiply; }
  .duotone::after { content: ''; position: absolute; inset: 0; background: var(--cobalto); mix-blend-mode: lighten; pointer-events: none; }
  @media (min-width: 900px) { .sobre__grid { grid-template-columns: 420px 1fr; gap: 6rem; } }

  .linha-do-tempo { list-style: none; margin: clamp(4rem, 8vw, 6rem) 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid rgb(255 255 255 / 0.2); }
  .linha-do-tempo li { padding: 1.4rem 0; border-bottom: 1px solid rgb(255 255 255 / 0.12); display: grid; gap: 0.3rem; }
  .linha-do-tempo__ano { font-family: var(--display); font-weight: 700; color: var(--ipe); }
  .linha-do-tempo h3 { color: #fff; margin: 0; font-size: 1.25rem; }
  .linha-do-tempo p { margin: 0; color: #a9a6c6; font-size: 0.97rem; }
  @media (min-width: 900px) {
    .linha-do-tempo { grid-template-columns: repeat(5, 1fr); border-top: 0; }
    .linha-do-tempo li { border-bottom: 0; border-top: 3px solid var(--ipe); padding: 1.3rem 1.5rem 0 0; align-content: start; }
  }

  /* ABORDAGEM */
  .abordagem { display: grid; gap: 2rem 4rem; }
  .abordagem h2 { margin: 0; }
  .abordagem__col h3 { font-size: 1.6rem; color: var(--cobalto); }
  .abordagem__col p { color: var(--tinta-suave); margin: 0; }
