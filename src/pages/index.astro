---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SITE, whatsappLink, telefoneFormatado } from '../config';
import { getCollection } from 'astro:content';
import foto from '../assets/marcel-paulino.webp';

const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);

const atendimentos = [
  {
    titulo: 'Psicoterapia individual',
    texto: 'Para adultos e adolescentes que querem entender o que sentem, lidar melhor com seus desafios e construir mudanças na própria vida.',
  },
  {
    titulo: 'Terapia de casal',
    texto: 'Um espaço para o casal olhar para a comunicação, os conflitos e os padrões que se repetem na relação, com ajuda de alguém de fora.',
  },
  {
    titulo: 'Terapia familiar',
    texto: 'Atendimento para famílias que querem melhorar a convivência, a comunicação e atravessar juntas momentos difíceis.',
  },
  {
    titulo: 'Aconselhamento breve',
    texto: 'Um acompanhamento focado e de curta duração para momentos de crise: perdas, separações, mudanças bruscas e decisões difíceis.',
  },
  {
    titulo: 'Atendimento online',
    texto: 'Sessões por vídeo de segunda a sábado, conforme as normas do CFP e do CRP-14/MS, com o mesmo cuidado e sigilo do presencial.',
  },
];

const temas = [
  'Ansiedade e transtornos de ansiedade',
  'Depressão e transtornos do humor',
  'Estresse e gerenciamento de estresse',
  'Fobias e medos',
  'Relacionamentos e comunicação',
  'Autoestima e autoaceitação',
  'Hábitos e vícios',
];

const passos = [
  { n: '01', titulo: 'Escolha um horário', texto: 'Pela agenda online você vê os horários disponíveis, os valores e já agenda a sua sessão. Se preferir, chame no WhatsApp.' },
  { n: '02', titulo: 'Primeira sessão', texto: 'Uma conversa para entender o que te traz, explicar como a terapia funciona e definirmos juntos os objetivos do processo.' },
  { n: '03', titulo: 'Acompanhamento', texto: 'Sessões presenciais em Campo Grande ou online, no ritmo que o processo pede, com revisão constante dos objetivos.' },
];

const faq = [
  {
    p: 'Como faço para agendar?',
    r: 'Pela agenda online você vê os horários livres, os valores e agenda direto, sem precisar esperar resposta. Se tiver dúvidas antes, é só chamar no WhatsApp.',
  },
  {
    p: 'Quais são as formas de pagamento?',
    r: 'Dinheiro, Pix e cartão de crédito ou débito. Os valores das sessões ficam disponíveis na agenda online.',
  },
  {
    p: 'Preciso estar em crise para começar a terapia?',
    r: 'Não. Muita gente procura terapia para se conhecer melhor, atravessar uma fase de mudança ou entender padrões que se repetem. Você é o especialista da sua vida, e a terapia é uma ferramenta para construir esse caminho.',
  },
  {
    p: 'A terapia online funciona?',
    r: 'Sim. O atendimento online é regulamentado pelo Conselho Federal de Psicologia e mantém o mesmo sigilo e cuidado do presencial. Basta um lugar reservado e uma boa conexão.',
  },
  {
    p: 'O que eu falar fica entre nós?',
    r: 'Sim. O sigilo é um dever ético do psicólogo, previsto no Código de Ética Profissional. As exceções são raras, previstas em lei, e sempre conversadas com você.',
  },
  {
    p: 'Quanto tempo dura o tratamento?',
    r: 'Depende do que te traz e do formato escolhido. O aconselhamento breve tem duração curta e focada; a psicoterapia trabalha com objetivos definidos em conjunto, e vamos avaliando juntos como o processo está caminhando.',
  },
];
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">{SITE.slogan} · presencial e online</p>
        <h1>Você é o <em>especialista</em> da sua vida.</h1>
        <p class="lead">
          Um espaço seguro e acolhedor para explorar seus desafios e alcançar seu potencial.
          Terapia para adultos, adolescentes, casais e famílias, sem julgamentos e sem dizer o
          que é certo ou errado.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={SITE.agenda} target="_blank" rel="noopener">Agendar consulta</a>
          <a class="btn btn--ghost" href={whatsappLink()} target="_blank" rel="noopener">Falar no WhatsApp</a>
        </div>
        <p class="hero__meta">{SITE.profissional} · Psicólogo clínico · {SITE.crp}</p>
      </div>

      <div class="hero__art" aria-hidden="true">
        <svg viewBox="0 0 400 420" fill="none">
          <rect x="30" y="20" width="340" height="380" rx="170" fill="#e2ebf3" />
          <circle cx="200" cy="210" r="120" fill="#efe6d8" />
          <circle cx="200" cy="210" r="120" stroke="#5b8bb7" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
          <circle cx="160" cy="190" r="56" fill="#b4573a" opacity="0.9" />
          <circle cx="240" cy="230" r="56" fill="#5b8bb7" opacity="0.85" />
          <path d="M70 330c60-40 120 30 180-10s80-30 100-20" stroke="#2a2622" stroke-width="2" stroke-linecap="round" />
          <circle cx="310" cy="90" r="10" fill="#b4573a" />
          <circle cx="92" cy="120" r="5" fill="#5b8bb7" />
        </svg>
      </div>
    </div>
  </section>

  <!-- SOBRE -->
  <section id="sobre" class="section section--alt">
    <div class="wrap sobre">
      <Image
        src={foto}
        alt="Marcel Paulino, psicólogo em Campo Grande"
        class="sobre__foto"
        widths={[380, 640]}
        sizes="(min-width: 900px) 380px, 90vw"
      />
      <div>
        <p class="eyebrow">Quem sou eu</p>
        <h2>Olá, sou {SITE.profissional}.</h2>
        <p>
          Tenho 45 anos, sou casado e pai de duas meninas, a Lara e a Zoe, e também dos pets
          Sexta-Feira e Thyka. Minha paixão por ouvir as pessoas é natural desde a adolescência,
          e isso só se confirmou quando decidi cursar Psicologia.
        </p>
        <p>
          Deixei para trás três anos de Ciência da Computação e troquei a lógica dos números pela
          subjetividade humana. Ser psicólogo é o cumprimento do meu propósito.
        </p>
        <p>
          Há mais de 12 anos atuo ajudando jovens, adultos, casais e famílias a se entenderem
          especialistas de suas vidas. Acredito que a terapia é uma ferramenta de construção do
          ser, fundamental para uma vida plena, e minha missão é te ajudar nesse processo.
        </p>
        <ul class="destaques">
          <li><strong>12+ anos</strong><span>de atuação clínica</span></li>
          <li><strong>TCC + Narrativa</strong><span>abordagens terapêuticas</span></li>
          <li><strong>{SITE.crp}</strong><span>psicólogo clínico</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ABORDAGEM -->
  <section id="abordagem" class="section">
    <div class="wrap abordagem">
      <div>
        <p class="eyebrow">Abordagem</p>
        <h2>Terapia cognitivo-comportamental e terapia narrativa</h2>
      </div>
      <div>
        <p class="lead">
          A TCC é uma abordagem baseada em evidências e tem se mostrado eficaz para uma variedade
          de questões psicológicas.
        </p>
        <p>
          Trabalhamos juntos para identificar pensamentos disfuncionais e padrões de comportamento,
          desenvolver estratégias para lidar com eles e promover mudanças positivas na sua vida.
        </p>
        <p>
          A terapia narrativa complementa esse trabalho olhando para as histórias que contamos sobre
          nós mesmos. Separar a pessoa do problema abre espaço para reescrever essas histórias e
          reconhecer os próprios recursos, porque quem conhece a sua vida é você.
        </p>
        <p>
          Cada pessoa é única, e o atendimento é personalizado para as suas necessidades, seja
          você adulto ou adolescente, esteja sozinho, em casal ou em família.
        </p>
      </div>
    </div>
  </section>

  <!-- ATENDIMENTO -->
  <section id="atendimento" class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Atendimento</p>
      <h2 class="title-max">Como posso te ajudar</h2>
      <div class="cards">
        {atendimentos.map((a) => (
          <article class="card">
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </article>
        ))}
      </div>

      <div class="temas">
        <div>
          <h3>Desafios que trabalho no consultório</h3>
          <p>Meu atendimento abrange uma ampla gama de questões emocionais e comportamentais, entre elas:</p>
        </div>
        <ul>
          {temas.map((t) => <li>{t}</li>)}
        </ul>
      </div>

      <div class="inclusivo">
        <h3>Atendimento inclusivo, sem distinção</h3>
        <p>
          Acredito na importância de um atendimento inclusivo e respeitoso. Atendo todas as pessoas,
          independentemente de identidade de gênero, orientação sexual, idade ou história de vida.
        </p>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-funciona" class="section section--green">
    <div class="wrap">
      <p class="eyebrow">Como funciona</p>
      <h2 class="title-max">Dar o primeiro passo é mais simples do que parece.</h2>
      <ol class="passos">
        {passos.map((s) => (
          <li>
            <span class="passos__n">{s.n}</span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </li>
        ))}
      </ol>
      <a class="btn btn--light" href={SITE.agenda} target="_blank" rel="noopener">Ver horários e valores</a>
    </div>
  </section>

  <!-- FAQ -->
  <section id="duvidas" class="section">
    <div class="wrap faq">
      <div>
        <p class="eyebrow">Dúvidas frequentes</p>
        <h2>Perguntas que muita gente faz antes de começar</h2>
      </div>
      <div class="faq__list">
        {faq.map((f) => (
          <details>
            <summary>{f.p}</summary>
            <p>{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOG -->
  {posts.length > 0 && (
    <section class="section section--alt">
      <div class="wrap">
        <div class="blog-head">
          <div>
            <p class="eyebrow">Blog</p>
            <h2>Textos para pensar com calma</h2>
          </div>
          <a href="/blog/">Ver todos os textos →</a>
        </div>
        <div class="posts">
          {posts.map((post) => (
            <a class="post" href={`/blog/${post.id}/`}>
              <time datetime={post.data.data.toISOString()}>
                {post.data.data.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })}
              </time>
              <h3>{post.data.titulo}</h3>
              <p>{post.data.resumo}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PARCEIROS -->
  <section class="parceiros" aria-label="Parceiros">
    <div class="wrap parceiros__inner">
      <p class="eyebrow">Parceiros</p>
      <ul>
        {SITE.parceiros.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato" class="section">
    <div class="wrap contato">
      <div>
        <p class="eyebrow">Contato</p>
        <h2>Seja qual for a sua jornada, estou aqui para apoiar.</h2>
        <p class="lead">
          Agende sua consulta e dê o primeiro passo em direção a uma vida mais plena e equilibrada.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={SITE.agenda} target="_blank" rel="noopener">Agendar consulta</a>
          <a class="btn btn--ghost" href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
      <dl class="contato__info">
        <div><dt>WhatsApp / Telefone</dt><dd><a href={whatsappLink()} target="_blank" rel="noopener">{telefoneFormatado()}</a></dd></div>
        <div>
          <dt>Consultório</dt>
          <dd>
            <a href={SITE.mapa} target="_blank" rel="noopener">{SITE.endereco}<br />{SITE.bairro} · {SITE.cidade}/{SITE.uf}</a>
          </dd>
        </div>
        <div>
          <dt>Horários</dt>
          <dd>
            Presencial: {SITE.horarios.presencial}<br />
            Online: {SITE.horarios.online}<br />
            {SITE.horarios.domingo}
          </dd>
        </div>
        <div><dt>Pagamento</dt><dd>{SITE.pagamento}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 7vw, 5rem); }
  .hero__grid { display: grid; gap: 3rem; align-items: center; }
  .hero h1 em { font-style: italic; color: var(--accent); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 2rem 0 1.5rem; }
  .hero__meta { font-size: 0.9rem; color: var(--ink-soft); }
  .hero__art { max-width: 420px; margin-inline: auto; width: 100%; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 1.25fr 1fr; } }

  .sobre { display: grid; gap: 3rem; align-items: center; }
  .sobre :global(.sobre__foto) {
    width: 100%; max-width: 380px; height: auto; margin-inline: auto;
    border-radius: 200px 200px var(--radius) var(--radius);
    object-fit: cover; aspect-ratio: 4 / 5;
  }
  .destaques {
    list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-top: 1px solid var(--line); padding-top: 1.5rem;
  }
  .destaques strong { display: block; white-space: nowrap; font-family: var(--serif); font-size: 1.35rem; font-weight: 500; color: var(--green); }
  .destaques span { font-size: 0.88rem; color: var(--ink-soft); }
  @media (min-width: 900px) { .sobre { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; } }

  .abordagem { display: grid; gap: 1.5rem; }
  .abordagem .lead { color: var(--ink); margin-bottom: 1.2rem; }
  .abordagem p { color: var(--ink-soft); }
  @media (min-width: 900px) { .abordagem { grid-template-columns: 1fr 1.4fr; gap: 5rem; } }

  .title-max { max-width: 30ch; }
  .cards { display: grid; gap: 1.2rem; margin-top: 2.5rem; }
  .card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.8rem; transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .card p { color: var(--ink-soft); margin: 0; }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1050px) { .cards { grid-template-columns: repeat(3, 1fr); } }

  .temas {
    display: grid; gap: 1.5rem; margin-top: 4rem; padding: 2.2rem;
    border-radius: var(--radius); background: var(--green-soft);
  }
  .temas ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem 2rem; align-content: start; }
  .temas li { padding-left: 1.4rem; position: relative; }
  .temas li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
  }
  @media (min-width: 800px) {
    .temas { grid-template-columns: 1fr 2fr; padding: 3rem; }
    .temas ul { grid-template-columns: 1fr 1fr; }
  }

  .inclusivo { margin-top: 1.2rem; padding: 2rem 2.2rem; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); }
  .inclusivo p { margin: 0; color: var(--ink-soft); max-width: 60rem; }

  .section--green { background: var(--green); color: #eef3f8; }
  .section--green .eyebrow { color: #f0b9a4; }
  .passos { list-style: none; padding: 0; margin: 2.5rem 0 2.5rem; display: grid; gap: 2.5rem; }
  .passos li { border-top: 1px solid rgb(255 255 255 / 0.25); padding-top: 1.5rem; }
  .passos__n { font-family: var(--serif); font-size: 2.6rem; color: #f0b9a4; line-height: 1; display: block; margin-bottom: 1rem; }
  .passos p { color: #d6e2ee; margin: 0; }
  .btn--light { background: var(--bg); color: var(--green); }
  .btn--light:hover { background: #fff; color: var(--green); }
  @media (min-width: 800px) { .passos { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  .faq { display: grid; gap: 2rem; }
  .faq__list details { border-bottom: 1px solid var(--line); }
  .faq__list summary {
    cursor: pointer; list-style: none; padding: 1.3rem 2.5rem 1.3rem 0; position: relative;
    font-weight: 600; font-size: 1.05rem;
  }
  .faq__list summary::-webkit-details-marker { display: none; }
  .faq__list summary::after {
    content: '+'; position: absolute; right: 0.3rem; top: 50%; transform: translateY(-50%);
    font-size: 1.6rem; font-weight: 300; color: var(--accent); transition: transform 0.2s;
  }
  .faq__list details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq__list details p { color: var(--ink-soft); padding-bottom: 1.2rem; margin: 0; }
  @media (min-width: 900px) { .faq { grid-template-columns: 1fr 1.6fr; gap: 5rem; } }

  .blog-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; }
  .posts { display: grid; gap: 1.2rem; margin-top: 2rem; }
  .post {
    display: block; padding: 1.8rem; border-radius: var(--radius); background: var(--surface);
    border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: border-color 0.2s;
  }
  .post:hover { border-color: var(--accent); color: var(--ink); }
  .post time { font-size: 0.85rem; color: var(--green); }
  .post h3 { margin: 0.5rem 0; }
  .post p { color: var(--ink-soft); margin: 0; font-size: 0.97rem; }
  @media (min-width: 800px) { .posts { grid-template-columns: repeat(3, 1fr); } }

  .parceiros { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 2rem 0; }
  .parceiros__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 3rem; }
  .parceiros .eyebrow { margin: 0; }
  .parceiros ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem 3rem; }
  .parceiros li { font-family: var(--serif); font-size: 1.4rem; color: var(--ink-soft); }

  .contato { display: grid; gap: 3rem; }
  .contato .hero__ctas { margin-bottom: 0; }
  .contato__info { margin: 0; display: grid; gap: 1.4rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 2rem; }
  .contato__info dt { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--green); font-weight: 600; }
  .contato__info dd { margin: 0.2rem 0 0; }
  @media (min-width: 900px) { .contato { grid-template-columns: 1.2fr 1fr; gap: 5rem; align-items: center; } }
</style>
