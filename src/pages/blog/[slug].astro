---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { whatsappLink } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.rascunho);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.titulo} description={post.data.resumo} type="article">
  <article class="section">
    <div class="wrap">
      <a href="/blog/" class="voltar">← Todos os textos</a>
      <header class="post-head">
        <time datetime={post.data.data.toISOString()}>
          {post.data.data.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })}
        </time>
        <h1>{post.data.titulo}</h1>
        <p class="lead">{post.data.resumo}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <aside class="cta">
        <p>Esse texto conversou com algo que você está vivendo?</p>
        <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener">Agendar uma conversa</a>
      </aside>
    </div>
  </article>
</Base>

<style>
  .voltar { font-size: 0.92rem; text-decoration: none; }
  .post-head { max-width: 46rem; margin: 2rem 0 3rem; }
  .post-head time { font-size: 0.85rem; color: var(--azul); display: block; margin-bottom: 0.8rem; }
  .post-head h1 { font-size: clamp(2rem, 4.5vw, 3.1rem); }
  .cta {
    max-width: 42rem; margin-top: 4rem; padding: 2rem; border-radius: 12px;
    background: var(--azul-suave); display: grid; gap: 1rem; justify-items: start;
  }
  .cta p { margin: 0; font-family: var(--serif); font-size: 1.3rem; }
</style>
